---
import MainLayout from '../../layouts/MainLayout.astro';

const devotions = [
  { id: 1, title: "Japangal (Common Prayers)", slug: "japangal", description: "Basic daily Catholic prayers (ജപങ്ങൾ).", icon: "🙏" },
  { id: 2, title: "Japamalakal (Rosaries)", slug: "japamala", description: "Malayalam Holy Rosary, Divine Mercy Chaplet, and devotions.", icon: "📿" },
  { id: 3, title: "Vedapadam (Catechism)", slug: "vedapadam", description: "Catholic teachings and basic beliefs (വേദപാഠം).", icon: "📖" },
  { id: 4, title: "Prarthanakal (Prayers)", slug: "general", description: "General devotions and prayers (പ്രാർത്ഥനകൾ).", icon: "🕯️" },
  { id: 5, title: "Madhyastha Prarthanakal", slug: "madhyastha", description: "Intercessory prayers to Saints (മദ്ധ്യസ്ഥ പ്രാർത്ഥനകൾ).", icon: "🕊️" },
  { id: 6, title: "Syro-Malabar Yama Prarthanakal", slug: "yamams", description: "Liturgy of the hours (Ramsha, Sapra etc.) categorized by time.", icon: "⛪" }
];
---

<MainLayout
  title="Catholic Prayers in Malayalam & Manglish - Rosary, Japam, Vedapadam | HolyfireMedia"
  description="Complete collection of Catholic prayers in Malayalam & Manglish. Includes Holy Rosary (Japamala), common prayers (Japangal), Catechism (Vedapadam), intercessory prayers, and Syro-Malabar Yama Prarthanakal."
  keywords="Catholic prayers Malayalam, Malayalam Rosary, Japamala Malayalam, Manglish prayers, Syro-Malabar prayers, Vedapadam, Japangal, Christian prayers online, karunakontha Malayalam, Hail Holy Queen Malayalam, Parishudha Rajni, പരിശുദ്ധ രാജ്ഞി, Salve Regina Malayalam, daily Catholic prayer Malayalam, ഇന്നത്തെ പ്രാർത്ഥന, daily prayer Malayalam, Catholic morning prayer, Manglish Catholic prayers"
>
  <div class="container mx-auto px-4 py-16">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-6">Prayer & Devotion</h1>
      <p class="text-xl text-purple-200">
        Find peace and grow in your faith with our collection of daily prayers, rosaries, and litanies.
      </p>
    </div>

    <!-- Daily Prayer Section -->
    <div class="max-w-5xl mx-auto mb-16">
      <div class="flex items-center gap-3 mb-6">
        <span class="text-2xl">🌅</span>
        <h2 class="text-2xl md:text-3xl font-bold text-white">Daily Prayer</h2>
        <span class="text-purple-300 text-lg font-medium">| ഇന്നത്തെ പ്രാർത്ഥന</span>
      </div>

      <a href="/prayers/japangal/parishudha-rajni" class="block group">
        <div class="relative bg-gradient-to-br from-purple-900/60 via-indigo-900/50 to-pink-900/40 backdrop-blur-md border border-pink-500/20 rounded-3xl p-8 md:p-10 shadow-2xl hover:shadow-[0_0_40px_rgba(236,72,153,0.25)] hover:-translate-y-1 transition-all duration-300 overflow-hidden">
          <!-- Decorative glow -->
          <div class="absolute top-0 right-0 w-64 h-64 bg-pink-500/10 rounded-full blur-3xl pointer-events-none"></div>
          <div class="absolute bottom-0 left-0 w-48 h-48 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>

          <div class="relative flex flex-col md:flex-row md:items-center gap-6">
            <div class="text-6xl bg-white/5 inline-flex p-5 rounded-2xl border border-white/10 group-hover:scale-110 transition-transform shrink-0">
              👑
            </div>
            <div class="flex-1">
              <div class="flex flex-wrap items-center gap-2 mb-2">
                <span class="text-xs font-bold text-pink-400 bg-pink-500/15 border border-pink-500/30 px-3 py-1 rounded-full uppercase tracking-wider">Featured Daily Prayer</span>
                <span class="text-xs font-semibold text-purple-300 bg-purple-500/10 border border-purple-500/20 px-3 py-1 rounded-full">Hail Holy Queen</span>
              </div>
              <h3 class="text-2xl md:text-3xl font-extrabold text-white mb-1 group-hover:text-pink-300 transition-colors">പരിശുദ്ധ രാജ്ഞി</h3>
              <p class="text-lg text-purple-200 mb-3">Parishudha Rajni &mdash; <span class="italic text-pink-200">Salve Regina</span></p>
              <p class="text-purple-300 text-sm md:text-base leading-relaxed line-clamp-2">പരിശുദ്ധ രാജ്ഞീ, കരുണയുള്ള മാതാവേ! സ്വസ്തി! ഞങ്ങളുടെ ജീവനും മാധുര്യവും ശരണവുമേ സ്വസ്തി!</p>
            </div>
            <div class="flex items-center text-pink-400 font-semibold gap-2 group-hover:text-pink-300 shrink-0">
              Pray Now
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </div>
          </div>
        </div>
      </a>
    </div>
    <!-- Prayer Categories -->
    <div class="max-w-5xl mx-auto">
      <div class="flex items-center gap-3 mb-6">
        <span class="text-2xl">📝</span>
        <h2 class="text-2xl md:text-3xl font-bold text-white">Browse by Category</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-8">
        {devotions.map((item) => (
          <a href={`/prayers/${item.slug}`} class="block group">
            <div class="bg-gradient-to-br from-indigo-900/40 to-purple-900/40 backdrop-blur-md border border-white/10 rounded-3xl p-8 shadow-xl hover:shadow-[0_0_20px_rgba(236,72,153,0.2)] hover:-translate-y-1 transition-all duration-300">
              <div class="text-5xl mb-6 bg-white/5 inline-flex p-4 rounded-2xl border border-white/5 group-hover:scale-110 transition-transform">
                {item.icon}
              </div>
              <h2 class="text-2xl font-bold text-white mb-3 group-hover:text-pink-300 transition-colors">{item.title}</h2>
              <p class="text-purple-200 mb-6">{item.description}</p>
              <div class="flex items-center text-pink-400 font-medium group-hover:text-pink-300">
                Read Prayer 
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</MainLayout>
