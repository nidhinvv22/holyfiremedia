---
import MainLayout from '../../layouts/MainLayout.astro';
import { songs } from '../../data/songs';
import { getLanguage } from '../../data/languages';

const songsWithLyrics = songs.filter(song => song.hasLyrics && song.lyrics);
---

<MainLayout
  title="Christian Songs Lyrics — Malayalam & Kannada | HolyfireMedia"
  description="Read and devotionally sing Christian song lyrics in Malayalam and Kannada with native script and English transliteration (Manglish / Kanglish)."
  keywords="Christian song lyrics, Malayalam Christian song lyrics, Kannada Christian song lyrics, Manglish lyrics, Kanglish lyrics, Catholic devotional lyrics"
>
  <div class="container mx-auto px-4 py-16">
    <div class="mb-12 max-w-2xl">
      <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-4">Song Lyrics</h1>
      <p class="text-xl text-purple-200">
        Sing along with our curated collection of Christian devotional song lyrics in Malayalam & Kannada with transliterations.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-8">
      {songsWithLyrics.map((song) => {
        const lang = getLanguage(song.language);
        return (
          <div class="bg-indigo-900/40 backdrop-blur-xl border border-white/10 rounded-3xl p-6 md:p-8 shadow-2xl relative overflow-hidden group">
            <!-- Decorative Blur Background -->
            <div class="absolute -top-10 -right-10 w-32 h-32 bg-pink-500/20 rounded-full blur-3xl mix-blend-screen opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            
            <div class="mb-6 border-b border-white/10 pb-6 relative z-10">
              <div class="flex items-center gap-2 mb-2">
                <span class={`text-xs px-2.5 py-0.5 rounded-full border font-semibold ${lang.badgeColor}`}>
                  {lang.name}
                </span>
              </div>
              <h2 class="text-2xl font-bold text-white mb-1 group-hover:text-pink-300 transition-colors">{song.title}</h2>
              <p class="text-purple-300">by {song.artist}</p>
            </div>
            
            <div class="relative z-10">
              <pre class="font-sans text-purple-100/90 whitespace-pre-line font-medium text-lg leading-relaxed italic border-l-4 border-pink-500/50 pl-4 mb-6">
                "{song.lyrics.transliterated.split('\n').slice(0, 2).map(line => line.trim()).filter(line => line).join('\n')}..."
              </pre>
              
              <a href={`/lyrics/${song.slug}`} class="w-full inline-block text-center py-3 bg-white/5 hover:bg-white/10 border border-white/20 text-white font-medium rounded-xl transition-all hover:border-pink-500/50 group-hover:shadow-[0_0_15px_rgba(236,72,153,0.3)]">
                Read Full Lyrics ({lang.name} & {lang.transliterationName})
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</MainLayout>
