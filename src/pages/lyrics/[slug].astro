---
import MainLayout from '../../layouts/MainLayout.astro';
import { songs } from '../../data/songs';
import { getLanguage } from '../../data/languages';

export async function getStaticPaths() {
  return songs.map((song) => {
    return {
      params: { slug: song.slug },
      props: { song },
    };
  });
}

const { song } = Astro.props;
const lang = getLanguage(song.language);
const artistHref = song.artistSlug ? `/artists/${song.artistSlug}` : "/artists";

const lyricsSchema = {
  "@context": "https://schema.org",
  "@type": "MusicComposition",
  "name": song.title,
  "composer": { "@type": "Person", "name": song.artist },
  "inLanguage": [lang.code, "en"],
  "genre": `${lang.name} Christian Devotional`,
  "url": `https://holyfiremedia.in/lyrics/${song.slug}`,
  "creator": {
    "@type": "Person",
    "name": song.artist,
    "url": song.artistSlug ? `https://holyfiremedia.in/artists/${song.artistSlug}/` : "https://holyfiremedia.in/artists/"
  },
  "lyrics": {
    "@type": "CreativeWork",
    "text": song.lyrics?.transliterated?.substring(0, 200) || ""
  }
};
---

<MainLayout
  title={`${song.title} Lyrics - ${lang.name} & ${lang.transliterationName} | ${song.artist} | HolyfireMedia`}
  description={`Read ${song.title} lyrics by ${song.artist} in ${lang.name} and ${lang.transliterationName}. Complete song lyrics for this ${lang.name} Christian devotional song.`}
  keywords={`${song.title} lyrics, ${song.title} lyrics ${lang.name}, ${song.title} ${lang.transliterationName} lyrics, ${song.artist} song lyrics, ${lang.name} Christian song lyrics`}
  schemaData={lyricsSchema}
>
  <div class="container mx-auto px-4 py-16">
    <div class="max-w-5xl mx-auto">
      <a href="/lyrics" class="inline-flex items-center text-pink-400 hover:text-pink-300 transition-colors mb-8 group">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 transform group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Lyrics List
      </a>

      <div class="flex flex-wrap items-center gap-3 mb-2">
        <span class={`px-3 py-1 text-xs font-bold rounded-full border ${lang.badgeColor}`}>
          {lang.name} ({lang.nativeName})
        </span>
      </div>

      <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-4">{song.title}</h1>
      <p class="text-xl text-purple-300 mb-12">
        By <a href={artistHref} class="hover:text-pink-300 transition-colors underline decoration-pink-400/40 underline-offset-4">{song.artist}</a>
      </p>

      {song.lyrics ? (
        <div class="bg-indigo-900/30 backdrop-blur-xl border border-white/10 rounded-3xl p-8 md:p-12 shadow-2xl relative">
          <!-- Language Toggle -->
          <div class="flex flex-wrap justify-center mb-8 gap-3 md:gap-4">
            <button id="btn-native" class="px-5 py-2 rounded-full bg-pink-600 font-bold text-white shadow-lg transition-all border border-pink-500 transform hover:scale-105 active:scale-95 text-sm md:text-base">{lang.nativeName} ({lang.name})</button>
            <button id="btn-transliterated" class="px-5 py-2 rounded-full bg-white/10 hover:bg-white/20 font-bold text-purple-200 transition-all border border-white/20 transform hover:scale-105 active:scale-95 text-sm md:text-base">{lang.transliterationName}</button>
          </div>

          <!-- Text Sections -->
          <div id="content-container" class="relative">
            <!-- Native Script Section -->
            <section id="sec-native" class="bg-white/5 p-6 md:p-8 rounded-2xl border border-white/5 block fade-in">
              <pre class={`${lang.fontClass} text-purple-100/90 whitespace-pre-wrap font-medium text-lg leading-loose break-words bg-transparent border-none`}>
                {song.lyrics.native.trim()}
              </pre>
            </section>

            <!-- Transliterated Section -->
            <section id="sec-transliterated" class="bg-white/5 p-6 md:p-8 rounded-2xl border border-white/5 hidden fade-in">
              <pre class="font-serif text-purple-100/90 whitespace-pre-wrap font-medium text-lg leading-loose break-words bg-transparent border-none">
                {song.lyrics.transliterated.trim()}
              </pre>
            </section>
          </div>

          <style>
            .fade-in {
              animation: fadeIn 0.4s ease-in-out forwards;
            }
            @keyframes fadeIn {
              from { opacity: 0; transform: translateY(5px); }
              to { opacity: 1; transform: translateY(0); }
            }
          </style>

          <script is:inline>
            document.addEventListener('DOMContentLoaded', () => {
              const btnNative = document.getElementById('btn-native');
              const btnTrans = document.getElementById('btn-transliterated');

              const secNative = document.getElementById('sec-native');
              const secTrans = document.getElementById('sec-transliterated');

              const activeBtnClass = 'bg-pink-600 text-white shadow-lg border-pink-500';
              const inactiveBtnClass = 'bg-white/10 text-purple-200 border-white/20 hover:bg-white/20';
              const baseBtnClass = 'px-5 py-2 rounded-full font-bold transition-all border transform hover:scale-105 active:scale-95 text-sm md:text-base';

              function setActiveState(activeBtn, activeSec) {
                if(!btnNative || !btnTrans || !secNative || !secTrans) return;

                // Reset buttons
                [btnNative, btnTrans].forEach(btn => {
                  btn.className = baseBtnClass + ' ' + inactiveBtnClass;
                });
                
                // Set active button
                activeBtn.className = baseBtnClass + ' ' + activeBtnClass;

                // Hide all sections
                [secNative, secTrans].forEach(sec => {
                  sec.classList.remove('block');
                  sec.classList.add('hidden');
                });
                
                // Show active section
                activeSec.classList.remove('hidden');
                activeSec.classList.add('block');
              }

              btnNative?.addEventListener('click', () => setActiveState(btnNative, secNative));
              btnTrans?.addEventListener('click', () => setActiveState(btnTrans, secTrans));
            });
          </script>
        </div>
      ) : (
        <div class="bg-white/5 border border-white/10 rounded-2xl p-12 text-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto text-purple-400 mb-4 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <p class="text-xl text-purple-200">Lyrics for this song are currently unavailable.</p>
        </div>
      )}

      {song.hasKaraoke && (
        <div class="mt-8 bg-gradient-to-r from-pink-500/10 to-purple-600/10 border border-pink-500/30 rounded-3xl p-6 md:p-8 flex flex-col md:flex-row items-center justify-between gap-6 backdrop-blur-sm">
          <div>
            <span class="inline-block px-3 py-1 text-xs font-bold rounded-full bg-pink-500/20 text-pink-300 border border-pink-500/30 mb-2">
              KARAOKE AVAILABLE
            </span>
            <h3 class="text-2xl font-bold text-white mb-1">Sing along with {song.title} Karaoke</h3>
            <p class="text-purple-200 text-sm">
              {song.price === 0 ? "Download free high-quality karaoke MP3 track for personal singing & devotion." : `Download karaoke audio tracks (${song.hasFreeVersion ? "Free MP3 & " : ""}Studio Instrumental).`}
            </p>
          </div>
          <a
            href={`/karaoke/${song.slug}`}
            class="px-6 py-3.5 bg-gradient-to-r from-pink-500 to-purple-600 hover:from-pink-400 hover:to-purple-500 text-white font-bold rounded-xl shadow-lg hover:shadow-pink-500/25 transition-all hover:scale-105 active:scale-95 text-center whitespace-nowrap"
          >
            {song.price === 0 ? "Download Free Karaoke" : "Get Karaoke Track"} →
          </a>
        </div>
      )}
    </div>
  </div>
</MainLayout>
