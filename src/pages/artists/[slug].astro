---
import MainLayout from '../../layouts/MainLayout.astro';
import PlayerModal from '../../components/PlayerModal.astro';
import frJosephImg from '../../assets/fr_joseph_mukkatt.webp';
import { songs } from '../../data/songs';
import { artists } from '../../data/artists';

export function getStaticPaths() {
  return artists.map((artist) => {
    return {
      params: { slug: artist.slug },
      props: { artist }
    };
  });
}

const { artist } = Astro.props;

const artistSongs = songs.filter(s => s.artistSlug === artist.slug || s.artist === artist.name).map(s => ({
  ...s,
  videoId: s.videoId || "NJAAUEmt_so"
}));

const decoratedSongs = artistSongs.map((s, index) => ({ ...s, id: index + 1, artist: artist.name }));
const playerPlaylist = decoratedSongs.map((song) => ({
  title: song.title,
  artist: song.artist,
  videoId: song.videoId,
}));
const featuredSong = decoratedSongs.find(song => song.slug === artist.featuredSongSlug) || decoratedSongs[0];

const artistImage = artist.slug === "fr-joseph-mukkatt" ? frJosephImg.src : "/holy_fire_logo.webp";
const artistImageUrl = new URL(artistImage, Astro.url).href;

const pageTitle = artist.seoTitle || `${artist.name} | HolyfireMedia`;
const pageDescription = artist.seoDescription || `Listen to songs and explore the discography of ${artist.name}.`;
const bioParas = artist.bio ? artist.bio.split('\n\n') : [];
const extendedParas = artist.extendedDescription ? artist.extendedDescription.split('\n\n') : [];
const artistLinks = artist.officialLinks || [];
const artistSameAs = artist.sameAs?.length ? artist.sameAs : artistLinks.map((link) => link.url);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": artist.name,
  "description": artist.bio || pageDescription,
  "url": `https://holyfiremedia.in/artists/${artist.slug}/`,
  "image": artistImageUrl,
  "mainEntityOfPage": `https://holyfiremedia.in/artists/${artist.slug}/`,
  "jobTitle": "Christian Music Artist",
  "knowsAbout": [
    "Malayalam Christian songs",
    "Catholic devotional music",
    "Malayalam worship songs"
  ],
  ...(artistSameAs.length ? { "sameAs": artistSameAs } : {}),
  "worksFor": {
    "@type": "Organization",
    "name": "HolyfireMedia"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://holyfiremedia.in/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Artists",
      "item": "https://holyfiremedia.in/artists/"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": artist.name,
      "item": `https://holyfiremedia.in/artists/${artist.slug}/`
    }
  ]
};

const getSocialLinkDetails = (name: string) => {
  const normalizedName = name.toLowerCase();
  if (normalizedName.includes('youtube')) {
    return {
      classes: "bg-red-500/10 hover:bg-red-500/20 border-red-500/30 hover:border-red-500/50 text-red-200 hover:text-white shadow-sm shadow-red-500/5",
      iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.163a3.003 3.003 0 0 0-2.11-2.11C19.518 3.545 12 3.545 12 3.545s-7.518 0-9.388.508a3.003 3.003 0 0 0-2.11 2.11C0 8.033 0 12 0 12s0 3.967.502 5.837a3.003 3.003 0 0 0 2.11 2.11c1.87.508 9.388.508 9.388.508s7.518 0 9.388-.508a3.003 3.003 0 0 0 2.11-2.11C24 15.967 24 12 24 12s0-3.967-.502-5.837zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`
    };
  }
  if (normalizedName.includes('spotify')) {
    return {
      classes: "bg-emerald-500/10 hover:bg-emerald-500/20 border-emerald-500/30 hover:border-emerald-500/50 text-emerald-200 hover:text-white shadow-sm shadow-emerald-500/5",
      iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.49 17.306c-.215.353-.676.463-1.028.249-2.813-1.722-6.354-2.11-10.523-1.157-.403.093-.81-.16-.903-.564-.093-.403.16-.81.564-.903 4.567-1.042 8.477-.6 11.64 1.34.352.215.463.676.25 1.035zm1.464-3.26c-.27.44-.848.58-1.288.31-3.218-1.977-8.125-2.55-11.93-1.393-.497.15-1.02-.132-1.17-.63-.15-.497.13-1.02.63-1.17 4.356-1.32 9.775-.68 13.447 1.58.44.27.58.85.31 1.29zM19.07 10.15c-.324.53-.993.7-1.52.375-3.77-2.242-9.988-2.45-13.568-1.362-.607.184-1.25-.154-1.436-.762-.185-.607.154-1.25.762-1.436 4.25-1.29 11.107-1.043 15.412 1.517.525.312.695.986.375 1.52z"/></svg>`
    };
  }
  if (normalizedName.includes('instagram')) {
    return {
      classes: "bg-gradient-to-r from-purple-500/10 to-pink-500/10 hover:from-purple-500/20 hover:to-pink-500/20 border-pink-500/25 hover:border-pink-500/40 text-pink-200 hover:text-white shadow-sm shadow-pink-500/5",
      iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>`
    };
  }
  return {
    classes: "bg-white/5 hover:bg-white/10 border-white/15 text-purple-200 hover:text-white shadow-sm",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>`
  };
};
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  image={artistImage}
  keywords={`${artist.name} songs, ${artist.name} lyrics, ${artist.name} karaoke, Malayalam Christian songs ${artist.name}, Catholic homily Malayalam`}
  schemaData={[personSchema, breadcrumbSchema]}
>
  <!-- Pass JSON stringified array to client script -->
  <script is:inline define:vars={{ playlist: playerPlaylist }}>
    window.artistPlaylist = playlist;
  </script>

  <div class="container mx-auto px-4 py-16">
    <!-- Artist Header -->
    <div class="bg-indigo-900/40 backdrop-blur-xl border border-white/10 rounded-3xl p-8 md:p-12 shadow-2xl mb-12 flex flex-col md:flex-row gap-8 items-center md:items-start text-center md:text-left relative overflow-hidden">
      <!-- Decorative Background elements -->
      <div class="absolute -top-24 -right-24 w-64 h-64 bg-pink-500/20 rounded-full blur-3xl mix-blend-screen pointer-events-none"></div>
      <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-purple-500/20 rounded-full blur-3xl mix-blend-screen pointer-events-none"></div>
      
      <div class="relative w-48 h-48 md:w-64 md:h-64 rounded-full border-4 border-white/20 shadow-xl overflow-hidden z-10 flex-shrink-0 bg-gradient-to-br from-indigo-900 to-purple-900 flex items-center justify-center">
        {artist.slug === "fr-joseph-mukkatt" ? (
          <img src={artistImage} alt={artist.name} class="w-full h-full object-cover transition-transform duration-500 hover:scale-110" />
        ) : (
          <span class="text-6xl font-bold text-white/50">{artist.name.split(' ').map(n => n[0]).join('')}</span>
        )}
      </div>
      
      <div class="flex-1 z-10 w-full">
        <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-4">{artist.name}</h1>
        <div class="text-lg text-purple-200 mb-6 leading-relaxed max-w-2xl space-y-4">
          {bioParas.map((para) => <p>{para}</p>)}
        </div>
        <div class="flex flex-wrap gap-4 justify-center md:justify-start">
          {decoratedSongs.length > 0 && (
            <button onclick="window.openGlobalPlayer(window.artistPlaylist, 0)" class="px-6 py-3 bg-pink-500 hover:bg-pink-400 text-white font-bold rounded-xl shadow-lg shadow-pink-500/30 transition-all flex items-center gap-2 transform hover:-translate-y-1 active:scale-95">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
              </svg>
              Play All Songs
            </button>
          )}
        </div>
        {artistLinks.length > 0 && (
          <div class="mt-6">
            <h2 class="text-sm font-bold uppercase text-purple-300 mb-3">Official Artist Links</h2>
            <div class="flex flex-wrap gap-3 justify-center md:justify-start">
              {artistLinks.map((link) => {
                const social = getSocialLinkDetails(link.name);
                return (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={`inline-flex items-center gap-2.5 px-5 py-2.5 rounded-xl border font-bold transition-all duration-300 transform hover:-translate-y-0.5 shadow-lg active:scale-95 ${social.classes}`}
                  >
                    <Fragment set:html={social.iconSvg} />
                    <span>{link.name}</span>
                  </a>
                );
              })}
            </div>
          </div>
        )}
      </div>
    </div>
    
    <!-- Featured Song Section -->
    {featuredSong && (
      <div class="mb-12 bg-gradient-to-r from-pink-900/30 to-purple-900/30 border border-pink-500/20 rounded-2xl p-6 md:p-8 backdrop-blur-sm shadow-xl flex flex-col md:flex-row items-center justify-between gap-6 hover:shadow-pink-500/10 transition-shadow">
        <div class="text-center md:text-left">
          <span class="text-pink-400 font-bold tracking-wider text-sm uppercase mb-2 block">Featured Song</span>
          <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">
            <a href={`/lyrics/${featuredSong.slug}`} class="hover:text-pink-300 transition-colors">
              {featuredSong.title}
              {featuredSong.alternateTitles?.[0] ? ` | ${featuredSong.alternateTitles[0]}` : ""}
            </a>
          </h2>
          <p class="text-purple-200">Read lyrics, listen online, and download the available karaoke version by {artist.name}.</p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3">
          {featuredSong.hasLyrics && (
            <a href={`/lyrics/${featuredSong.slug}`} class="px-6 py-3 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-bold rounded-xl transition-colors text-center">
              Read Lyrics
            </a>
          )}
          {featuredSong.hasKaraoke && (
            <a href={`/karaoke/${featuredSong.slug}`} class="px-6 py-3 bg-gradient-to-r from-pink-500 to-purple-600 hover:from-pink-400 hover:to-purple-500 text-white font-bold rounded-xl shadow-lg shadow-pink-500/30 transition-colors text-center">
              Download Karaoke
            </a>
          )}
        </div>
      </div>
    )}

    {/* SEO Oriented Content Sections */}
    <div class="grid md:grid-cols-2 gap-8 mb-12">
      {artist.extendedDescription && (
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 backdrop-blur-sm shadow-xl transition-all hover:bg-white/10">
          <h2 class="text-2xl font-bold text-white mb-4">Learn More About {artist.name}</h2>
          <div class="text-purple-200 leading-relaxed space-y-4">
            {extendedParas.map((para) => <p>{para}</p>)}
          </div>
        </div>
      )}
  
      {artist.aboutMinistry && (
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 backdrop-blur-sm shadow-xl transition-all hover:bg-white/10">
          <h2 class="text-2xl font-bold text-white mb-4">About His Ministry</h2>
          <div class="text-purple-200 leading-relaxed text-lg">
            <p>{artist.aboutMinistry}</p>
          </div>
        </div>
      )}
    </div>

    <!-- Artist's Songs List -->
    <h2 class="text-3xl font-bold text-white mb-6">Listen to Songs by {artist.name}</h2>
    <div class="grid gap-4">
      {decoratedSongs.map((song, index) => (
        <div onclick={`window.openGlobalPlayer(window.artistPlaylist, ${index})`} class="flex flex-col sm:flex-row items-center justify-between p-5 bg-white/5 hover:bg-white/10 border border-white/5 hover:border-pink-500/30 rounded-2xl transition-all duration-300 group shadow-lg hover:shadow-pink-500/10 cursor-pointer">
          <div class="flex items-center gap-4 w-full sm:w-auto mb-4 sm:mb-0">
            <div class="text-xl font-bold text-purple-400 w-8 text-center group-hover:text-pink-400 transition-colors">{index + 1}</div>
            
            {/* Play Button simulating Modal Open */}
            <button class="h-12 w-12 flex-shrink-0 rounded-lg bg-pink-500/20 flex items-center justify-center cursor-pointer hover:bg-pink-500 hover:text-white text-pink-300 transition-all transform group-hover:scale-110 active:scale-95 shadow-md" title="Play">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 ml-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
              </svg>
            </button>
            
            <div>
              <h3 class="text-lg font-bold text-white group-hover:text-pink-300 transition-colors">
                <a href={song.hasLyrics ? `/lyrics/${song.slug}` : "/songs"} onclick="event.stopPropagation()" class="hover:text-pink-300 transition-colors">
                  {song.title}
                </a>
              </h3>
              {song.hasKaraoke ? (
                <span class="text-xs font-semibold bg-emerald-500/20 text-emerald-300 px-2 py-1 rounded shadow-sm inline-flex items-center gap-1"><span class="text-[10px]">🎤</span> Karaoke Available</span>
              ) : (
                <span class="text-xs font-semibold text-purple-300 bg-purple-900/40 px-2 py-1 rounded shadow-sm">Vocals Only</span>
              )}
            </div>
          </div>
          
          <div class="flex gap-3 w-full sm:w-auto mt-4 sm:mt-0 justify-end flex-wrap">
            {song.hasLyrics !== false && (
              <a href={song.slug ? `/lyrics/${song.slug}` : "/lyrics"} onclick="event.stopPropagation()" class="flex-1 sm:flex-none flex items-center justify-center px-6 py-2 bg-white/10 hover:bg-white/20 text-white font-medium rounded-lg transition-all border border-white/10 shadow-sm hover:shadow-md hover:-translate-y-0.5 text-sm md:text-base">
                Lyrics
              </a>
            )}
            {song.hasKaraoke && (
              <div class="flex-1 sm:flex-none flex flex-col items-center">
                <a href={song.slug ? `/karaoke/${song.slug}` : "/karaoke"} onclick="event.stopPropagation()" class="w-full text-center px-4 md:px-6 py-2 bg-gradient-to-r from-purple-500 to-indigo-600 hover:from-purple-400 hover:to-indigo-500 text-white font-medium rounded-lg shadow-md transition-all hover:shadow-lg hover:-translate-y-0.5 active:scale-95 text-nowrap flex items-center gap-2 justify-center text-sm md:text-base">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                    <path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.31-1.243A1 1 0 005 1H3zM16 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM6.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3z" />
                  </svg>
                  Download Karaoke
                </a>
                <span class="text-[10px] text-purple-300 mt-1.5 opacity-80">Instant download after payment</span>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- What is Karaoke Section -->
    <div class="mt-12 bg-indigo-900/40 border border-indigo-500/30 rounded-2xl p-6 md:p-8 backdrop-blur-sm shadow-xl">
      <h2 class="text-2xl font-bold text-white mb-6 flex items-center gap-3">
        <span class="text-2xl">🎤</span> What is Karaoke?
      </h2>
      <div class="grid sm:grid-cols-2 gap-6 text-purple-200">
        <div class="bg-white/5 border border-white/10 hover:border-pink-500/30 transition-colors rounded-xl p-6">
          <h3 class="font-bold text-pink-300 mb-2 text-lg">With Chorus</h3>
          <p class="text-sm md:text-base">Free version that includes backing vocals. Great for learning the lyrics and familiarizing yourself with the rhythm.</p>
        </div>
        <div class="bg-white/5 border border-white/10 hover:border-emerald-500/30 transition-colors rounded-xl p-6">
          <h3 class="font-bold text-emerald-300 mb-2 text-lg">Without Chorus</h3>
          <p class="text-sm md:text-base">Paid instrumental version perfect for singing practice, creating covers, and performing at devotional events.</p>
        </div>
      </div>
    </div>

    <!-- Final SEO Paragraph -->
    <div class="mt-16 text-center border-t border-white/10 pt-8 pb-4">
      <p class="text-purple-300 text-sm md:text-base max-w-4xl mx-auto leading-relaxed">
        {artist.name === "Fr. Joseph Mukkatt" ? "Fr Joseph Mukkatt Malayalam Christian songs, homilies, and devotional music are widely loved among believers. Explore lyrics, listen online, and download karaoke tracks for personal use." : `Discover top Christian tracks from ${artist.name}. Enjoy lyrics and get karaoke versions instantly.`}
      </p>
    </div>
  </div>

  <PlayerModal />
</MainLayout>
