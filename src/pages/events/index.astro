---
import MainLayout from "../../layouts/MainLayout.astro";
import { events } from "../../data/events";

const sortedEvents = [...events].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://holyfiremedia.in/" },
    { "@type": "ListItem", position: 2, name: "Events", item: "https://holyfiremedia.in/events/" },
  ],
};
---

<MainLayout
  title="Christian Events & Retreats | Malayalam Catholic Conventions | HolyfireMedia"
  description="Discover upcoming Malayalam Christian events, Bible conventions, retreats, and prayer meetings worldwide. Stay updated with Syro-Malabar Catholic community events."
  keywords="Malayalam Christian events, Bible convention London, Syro-Malabar events UK, Catholic retreat, prayer meeting Malayalam, healing convention"
  schemaData={breadcrumbSchema}
>
  <div class="container mx-auto px-4 py-16">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h1 class="text-4xl md:text-6xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-pink-300 to-purple-300 drop-shadow-lg mb-6">
        Events & Retreats
      </h1>
      <p class="text-xl text-purple-200 leading-relaxed">
        Upcoming Malayalam Christian events, Bible conventions, and spiritual retreats from around the world.
      </p>
    </div>

    <div class="max-w-5xl mx-auto grid gap-8">
      {sortedEvents.map((event) => {
        const eventDate = new Date(event.date);
        const month = eventDate.toLocaleString("en-US", { month: "short" }).toUpperCase();
        const day = eventDate.getDate();
        const year = eventDate.getFullYear();

        return (
          <a
            href={`/events/${event.slug}`}
            class="group block bg-white/10 backdrop-blur-xl border border-white/20 rounded-3xl overflow-hidden hover:shadow-[0_0_40px_rgba(236,72,153,0.2)] hover:scale-[1.01] transition-all duration-300"
          >
            <div class="flex flex-col md:flex-row">
              {/* Event Poster */}
              <div class="md:w-80 flex-shrink-0 relative overflow-hidden">
                <img
                  src={event.image}
                  alt={event.title}
                  class="w-full h-64 md:h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent md:bg-gradient-to-r" />
              </div>

              {/* Event Info */}
              <div class="flex-1 p-6 md:p-8 flex flex-col justify-center">
                <div class="flex items-start gap-4 mb-4">
                  {/* Date Badge */}
                  <div class="flex-shrink-0 bg-gradient-to-br from-pink-500 to-purple-600 rounded-2xl p-3 text-center shadow-lg min-w-[70px]">
                    <div class="text-xs font-bold text-pink-200 tracking-wider">{month}</div>
                    <div class="text-3xl font-extrabold text-white leading-none">{day}</div>
                    <div class="text-xs font-medium text-purple-200">{year}</div>
                  </div>
                  <div>
                    {event.titleMalayalam && (
                      <p class="text-sm text-pink-300 font-medium mb-1">{event.titleMalayalam}</p>
                    )}
                    <h2 class="text-xl md:text-2xl font-bold text-white group-hover:text-pink-300 transition-colors">
                      {event.title}
                    </h2>
                  </div>
                </div>

                <div class="space-y-2 text-sm text-purple-200 mb-4">
                  <p class="flex items-center gap-2">
                    <span>🕐</span> {event.time}
                  </p>
                  <p class="flex items-center gap-2">
                    <span>📍</span> {event.location.name}, {event.location.city}
                  </p>
                  <p class="flex items-center gap-2">
                    <span>🏛️</span> {event.organizer}
                  </p>
                </div>

                <p class="text-purple-100 text-sm leading-relaxed line-clamp-2 mb-4">
                  {event.description}
                </p>

                <div class="flex flex-wrap gap-2">
                  {event.activities.slice(0, 4).map((activity) => (
                    <span class="px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs text-purple-200 font-medium">
                      {activity}
                    </span>
                  ))}
                  {event.activities.length > 4 && (
                    <span class="px-3 py-1 rounded-full bg-pink-500/10 border border-pink-500/20 text-xs text-pink-300 font-medium">
                      +{event.activities.length - 4} more
                    </span>
                  )}
                </div>
              </div>
            </div>
          </a>
        );
      })}
    </div>

    {sortedEvents.length === 0 && (
      <div class="text-center py-20">
        <p class="text-purple-300 text-lg">No events scheduled yet. Check back soon!</p>
      </div>
    )}
  </div>
</MainLayout>
