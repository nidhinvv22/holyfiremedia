---
import MainLayout from "../../layouts/MainLayout.astro";
import { events } from "../../data/events";

export async function getStaticPaths() {
  return events.map((event) => ({
    params: { slug: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props;

const eventDate = new Date(event.date);
const formattedDate = eventDate.toLocaleDateString("en-GB", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
});
const monthShort = eventDate.toLocaleString("en-US", { month: "short" }).toUpperCase();
const day = eventDate.getDate();
const year = eventDate.getFullYear();

const pageUrl = `https://holyfiremedia.in/events/${event.slug}/`;

// Event schema for SEO
const eventSchema = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: event.title,
  alternateName: event.titleMalayalam,
  description: event.description,
  startDate: `${event.date}T09:30:00+00:00`,
  endDate: `${event.date}T16:00:00+00:00`,
  eventStatus: "https://schema.org/EventScheduled",
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  image: `https://holyfiremedia.in${event.image}`,
  url: pageUrl,
  location: {
    "@type": "Place",
    name: event.location.name,
    address: {
      "@type": "PostalAddress",
      streetAddress: event.location.address,
      addressLocality: event.location.city,
      addressCountry: event.location.country,
    },
  },
  organizer: {
    "@type": "Organization",
    name: event.organizer,
    url: "https://holyfiremedia.in/",
  },
  performer: event.speakers.map((s) => ({
    "@type": "Person",
    name: s.name,
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://holyfiremedia.in/" },
    { "@type": "ListItem", position: 2, name: "Events", item: "https://holyfiremedia.in/events/" },
    { "@type": "ListItem", position: 3, name: event.title, item: pageUrl },
  ],
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: event.title,
  description: event.description,
  image: `https://holyfiremedia.in${event.image}`,
  url: pageUrl,
  datePublished: event.date,
  author: {
    "@type": "Organization",
    name: "HolyfireMedia",
  },
  publisher: {
    "@type": "Organization",
    name: "HolyfireMedia",
    logo: {
      "@type": "ImageObject",
      url: "https://holyfiremedia.in/holy_fire_logo.webp",
    },
  },
};

const shareText = `${event.title} - ${formattedDate}\n${event.location.name}, ${event.location.city}\n${pageUrl}`;
const whatsappUrl = `https://wa.me/?text=${encodeURIComponent(shareText)}`;
---

<MainLayout
  title={`${event.title} | ${formattedDate} | ${event.location.city} | HolyfireMedia`}
  description={event.description}
  image={event.image}
  keywords={`${event.title}, ${event.titleMalayalam || ""}, Bible convention London, Malayalam Christian event UK, Syro-Malabar retreat, ${event.speakers.map(s => s.name).join(", ")}, ${event.tags.join(", ")}`}
  ogType="article"
  schemaData={[eventSchema, breadcrumbSchema, articleSchema]}
>
  <div class="container mx-auto px-4 py-12">
    <!-- Back Link -->
    <a
      href="/events"
      class="inline-flex items-center text-pink-400 hover:text-pink-300 transition-colors mb-8 group"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 transform group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      All Events
    </a>

    <!-- Hero Section -->
    <div class="max-w-5xl mx-auto mb-12">
      <!-- Event Banner -->
      <div class="relative rounded-3xl overflow-hidden shadow-2xl mb-10">
        <img
          src={event.image}
          alt={event.title}
          class="w-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent" />
        
        <!-- Date Badge Overlay -->
        <div class="absolute bottom-6 left-6 flex items-end gap-4">
          <div class="bg-gradient-to-br from-pink-500 to-purple-600 rounded-2xl p-4 text-center shadow-xl min-w-[80px] border border-white/20">
            <div class="text-xs font-bold text-pink-200 tracking-wider">{monthShort}</div>
            <div class="text-4xl font-extrabold text-white leading-none">{day}</div>
            <div class="text-xs font-medium text-purple-200">{year}</div>
          </div>
          <div class="mb-1">
            {event.recurrence && (
              <span class="inline-block px-3 py-1 rounded-full bg-amber-500/20 border border-amber-500/30 text-xs text-amber-300 font-medium mb-2">
                🔁 {event.recurrence}
              </span>
            )}
          </div>
        </div>
      </div>

      <!-- Title Section -->
      <div class="text-center mb-12">
        {event.titleMalayalam && (
          <p class="text-2xl md:text-3xl text-pink-300 font-bold mb-3">{event.titleMalayalam}</p>
        )}
        <h1 class="text-3xl md:text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-pink-300 to-purple-300 drop-shadow-lg mb-4">
          {event.title}
        </h1>
        <p class="text-lg text-purple-200 max-w-3xl mx-auto leading-relaxed">
          {event.description}
        </p>

        {event.descriptionMalayalam && (
          <blockquote class="mt-6 max-w-2xl mx-auto px-6 py-4 bg-white/5 border-l-4 border-pink-500 rounded-r-xl italic text-purple-200 text-base">
            {event.descriptionMalayalam}
          </blockquote>
        )}
      </div>

      <!-- Quick Info Cards -->
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-12">
        <div class="bg-white/10 backdrop-blur border border-white/20 rounded-2xl p-5 text-center">
          <div class="text-3xl mb-2">📅</div>
          <h3 class="text-sm font-semibold text-purple-300 mb-1">Date</h3>
          <p class="text-white font-bold">{formattedDate}</p>
        </div>
        <div class="bg-white/10 backdrop-blur border border-white/20 rounded-2xl p-5 text-center">
          <div class="text-3xl mb-2">🕐</div>
          <h3 class="text-sm font-semibold text-purple-300 mb-1">Time</h3>
          <p class="text-white font-bold">{event.time}</p>
        </div>
        <div class="bg-white/10 backdrop-blur border border-white/20 rounded-2xl p-5 text-center">
          <div class="text-3xl mb-2">📍</div>
          <h3 class="text-sm font-semibold text-purple-300 mb-1">Venue</h3>
          <p class="text-white font-bold text-sm">{event.location.name}</p>
        </div>
        <div class="bg-white/10 backdrop-blur border border-white/20 rounded-2xl p-5 text-center">
          <div class="text-3xl mb-2">🏛️</div>
          <h3 class="text-sm font-semibold text-purple-300 mb-1">Organizer</h3>
          <p class="text-white font-bold text-xs leading-snug">{event.organizer}</p>
        </div>
      </div>

      <!-- Main Content Grid -->
      <div class="grid lg:grid-cols-[1.3fr_0.7fr] gap-8 mb-12">
        <!-- Left Column -->
        <div class="space-y-8">
          <!-- Activities / What to Expect -->
          <section class="bg-indigo-900/40 border border-white/10 rounded-3xl p-6 md:p-8 backdrop-blur-sm">
            <h2 class="text-2xl font-bold text-white mb-6 flex items-center gap-3">
              <span class="w-10 h-10 rounded-xl bg-gradient-to-r from-pink-500 to-purple-600 flex items-center justify-center text-lg shadow-lg">✨</span>
              What to Expect
            </h2>
            <div class="grid sm:grid-cols-2 gap-4">
              {event.activities.map((activity, i) => (
                <div class="flex items-center gap-3 p-3 rounded-xl bg-white/5 border border-white/10 hover:bg-white/10 transition-colors">
                  <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-gradient-to-r from-pink-500/20 to-purple-500/20 border border-pink-500/30 flex items-center justify-center text-sm">
                    {["🙏", "⛪", "🕯️", "📖", "🙌", "✝️"][i % 6]}
                  </span>
                  <span class="text-purple-100 font-medium">{activity}</span>
                </div>
              ))}
            </div>
            {event.notes && event.notes.length > 0 && (
              <div class="mt-6 space-y-2">
                {event.notes.map((note) => (
                  <div class="flex items-start gap-2 text-sm text-amber-200 bg-amber-500/10 border border-amber-500/20 rounded-xl px-4 py-3">
                    <span class="flex-shrink-0 mt-0.5">ℹ️</span>
                    <span>{note}</span>
                  </div>
                ))}
              </div>
            )}
          </section>

          <!-- Speakers -->
          <section class="bg-indigo-900/40 border border-white/10 rounded-3xl p-6 md:p-8 backdrop-blur-sm">
            <h2 class="text-2xl font-bold text-white mb-6 flex items-center gap-3">
              <span class="w-10 h-10 rounded-xl bg-gradient-to-r from-pink-500 to-purple-600 flex items-center justify-center text-lg shadow-lg">🎤</span>
              Speakers & Leaders
            </h2>
            <div class="grid sm:grid-cols-2 gap-4">
              {event.speakers.map((speaker) => (
                <div class="flex items-center gap-4 p-4 rounded-2xl bg-white/5 border border-white/10 hover:bg-white/10 transition-colors group">
                  <div class="flex-shrink-0 w-14 h-14 rounded-full bg-gradient-to-br from-pink-500 to-purple-600 flex items-center justify-center text-white font-bold text-xl shadow-lg border-2 border-white/20">
                    {speaker.name.charAt(0)}
                  </div>
                  <div>
                    <h3 class="text-white font-bold group-hover:text-pink-300 transition-colors">{speaker.name}</h3>
                    {speaker.title && (
                      <p class="text-purple-300 text-sm">{speaker.title}</p>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </section>
        </div>

        <!-- Right Column — Sidebar -->
        <div class="space-y-6">
          <!-- Location Card -->
          <div class="bg-white/10 backdrop-blur border border-white/20 rounded-3xl p-6 sticky top-24">
            <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
              📍 Venue & Location
            </h3>
            <div class="space-y-3 text-sm">
              <div>
                <p class="text-white font-semibold text-base">{event.location.name}</p>
                <p class="text-purple-200">{event.location.address}</p>
                <p class="text-purple-200">{event.location.city}</p>
              </div>
              {event.location.mapUrl && (
                <a
                  href={event.location.mapUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 hover:bg-white/20 border border-white/10 rounded-xl text-white text-sm font-medium transition-colors"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                  Open in Google Maps
                </a>
              )}
            </div>

            <hr class="border-white/10 my-5" />

            <!-- Contact -->
            <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
              📞 Contact & Enquiry
            </h3>
            <div class="space-y-3">
              {event.contact.map((c) => (
                <a
                  href={`tel:${c.phone.replace(/\s/g, "")}`}
                  class="flex items-center gap-3 text-purple-100 hover:text-pink-300 transition-colors"
                >
                  <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-green-500/20 border border-green-500/30 flex items-center justify-center text-sm">📱</span>
                  <div>
                    <p class="font-semibold text-sm">{c.name}</p>
                    <p class="text-xs text-purple-300">{c.phone}</p>
                  </div>
                </a>
              ))}
              {event.email && (
                <a
                  href={`mailto:${event.email}`}
                  class="flex items-center gap-3 text-purple-100 hover:text-pink-300 transition-colors"
                >
                  <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-blue-500/20 border border-blue-500/30 flex items-center justify-center text-sm">✉️</span>
                  <div>
                    <p class="font-semibold text-sm">Email</p>
                    <p class="text-xs text-purple-300">{event.email}</p>
                  </div>
                </a>
              )}
            </div>

            <hr class="border-white/10 my-5" />

            <!-- Share Buttons -->
            <h3 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
              📤 Share This Event
            </h3>
            <div class="space-y-3">
              <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center gap-2 w-full px-4 py-3 bg-green-600 hover:bg-green-500 text-white font-bold rounded-xl transition-colors shadow-lg"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                Share on WhatsApp
              </a>
              <button
                id="copy-link-btn"
                type="button"
                data-url={pageUrl}
                class="flex items-center justify-center gap-2 w-full px-4 py-3 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold rounded-xl transition-colors cursor-pointer"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" /></svg>
                <span id="copy-text">Copy Link</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const copyBtn = document.getElementById('copy-link-btn');
    const copyText = document.getElementById('copy-text');
    if (copyBtn && copyText) {
      copyBtn.addEventListener('click', async () => {
        const url = copyBtn.getAttribute('data-url') || window.location.href;
        try {
          await navigator.clipboard.writeText(url);
          copyText.textContent = 'Copied! ✓';
          setTimeout(() => { copyText.textContent = 'Copy Link'; }, 2000);
        } catch {
          copyText.textContent = 'Failed to copy';
          setTimeout(() => { copyText.textContent = 'Copy Link'; }, 2000);
        }
      });
    }
  </script>
</MainLayout>
