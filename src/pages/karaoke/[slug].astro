---
import MainLayout from "../../layouts/MainLayout.astro";
import { songs } from "../../data/songs";
import aradhyaneFile from "../../assets/Aradhyane_Parishudane_Ennullam_Thirayunnori_sneham.mp3";
import previewEnullam from "../../assets/enullam_sample.MP3";
import previewNoChorus from "../../assets/enullam_sample_no_chorus.MP3";

export async function getStaticPaths() {
  return songs
    .filter((song) => song.hasKaraoke)
    .map((song) => {
      return {
        params: { slug: song.slug },
        props: { song },
      };
    });
}

const { song } = Astro.props;
const { slug } = Astro.params;

let downloadUrl = song.freeFile;
let previewUrl = `/audio/preview-${song.slug}.mp3`;
let premiumPreviewUrl = `/audio/preview-premium-${song.slug}.mp3`;
if (slug === "aradhyane-parishudhane") {
  downloadUrl = aradhyaneFile;
  previewUrl = previewEnullam;
  premiumPreviewUrl = previewNoChorus;
}

const pageUrl = `https://holyfiremedia.in/karaoke/${song.slug}/`;
const artistUrl = song.artistSlug
  ? `https://holyfiremedia.in/artists/${song.artistSlug}/`
  : "https://holyfiremedia.in/artists/";
const artistHref = song.artistSlug ? `/artists/${song.artistSlug}` : "/artists";
const songAliases = song.alternateTitles || [];
const aliasText = songAliases.length
  ? ` Also searched as ${songAliases.join(", ")}.`
  : "";
const previewFileUrl = previewUrl
  ? new URL(previewUrl, Astro.url).href
  : undefined;
const [durationMinutes = 0, durationSeconds = 0] = song.duration
  .split(":")
  .map(Number);
const isoDuration = `PT${durationMinutes}M${durationSeconds}S`;
const razorpayKeyId = import.meta.env.PUBLIC_RAZORPAY_KEY_ID || "";

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: `${song.title} Karaoke Track`,
  description: `Download ${song.title} karaoke by ${song.artist}. Free MP3 with chorus and premium studio instrumental version available.`,
  image: "https://holyfiremedia.in/holy_fire_logo.webp",
  brand: {
    "@type": "Brand",
    name: "HolyfireMedia",
  },
  category: "Digital music download",
  url: pageUrl,
  offers: [
    {
      "@type": "Offer",
      name: "Free MP3 karaoke with chorus",
      price: "0",
      priceCurrency: "INR",
      availability: "https://schema.org/InStock",
      url: pageUrl,
    },
    {
      "@type": "Offer",
      name: "Premium studio instrumental karaoke",
      price: String(song.price),
      priceCurrency: "INR",
      availability: "https://schema.org/InStock",
      url: pageUrl,
    },
  ],
};

const musicSchema = {
  "@context": "https://schema.org",
  "@type": "MusicRecording",
  name: song.title,
  alternateName: songAliases,
  byArtist: {
    "@type": "Person",
    name: song.artist,
    url: artistUrl,
  },
  inLanguage: "ml",
  description: song.description,
  duration: isoDuration,
  url: pageUrl,
  ...(previewFileUrl ? { audio: previewFileUrl } : {}),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://holyfiremedia.in/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Karaoke",
      item: "https://holyfiremedia.in/karaoke/",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: `${song.title} Karaoke Download`,
      item: pageUrl,
    },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: `Can I download ${song.title} karaoke for free?`,
      acceptedAnswer: {
        "@type": "Answer",
        text: `Yes. HolyfireMedia provides a free MP3 karaoke version of ${song.title} with chorus for personal devotional practice.`,
      },
    },
    {
      "@type": "Question",
      name: `Is a premium instrumental version of ${song.title} available?`,
      acceptedAnswer: {
        "@type": "Answer",
        text: `Yes. A premium studio instrumental version without chorus is available for ${song.price} INR per track.`,
      },
    },
    {
      "@type": "Question",
      name: `Who is the artist of ${song.title}?`,
      acceptedAnswer: {
        "@type": "Answer",
        text: `${song.title} is a Malayalam Christian devotional song by ${song.artist}.`,
      },
    },
  ],
};
---

<MainLayout
  title={`${song.title} Karaoke Download MP3 | ${song.artist} | HolyfireMedia`}
  description={`Download ${song.title} karaoke track by ${song.artist}. Free MP3 with chorus and premium studio instrumental available for Malayalam Christian worship.${aliasText}`}
  keywords={`${song.title} karaoke download, ${song.title} karaoke, ${song.artist} karaoke, ${songAliases.join(", ")}, Malayalam Christian karaoke download, Catholic devotional karaoke`}
  ogType="music.song"
  schemaData={[productSchema, musicSchema, breadcrumbSchema, faqSchema]}
>
  <div class="container mx-auto px-4 py-16">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <a
        href="/karaoke"
        class="inline-flex items-center text-pink-400 hover:text-pink-300 transition-colors mb-8 group"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5 mr-2 transform group-hover:-translate-x-1 transition-transform"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to Karaoke List
      </a>

      <h1
        class="text-4xl md:text-6xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-pink-300 to-purple-300 drop-shadow-lg mb-6"
      >
        {song.title} Karaoke Download
      </h1>
      <p class="text-2xl text-white mb-6 font-semibold">
        Artist: <a
          href={artistHref}
          class="hover:text-pink-300 transition-colors underline decoration-pink-400/40 underline-offset-4"
          >{song.artist}</a
        >
      </p>

      {/* Audio Comparison — Hear the Difference */}
      <div class="mt-14 mb-4 max-w-3xl mx-auto animate-fade-in-up">
        <h3 class="text-xl font-bold text-white text-center mb-2">
          🎧 Hear the Difference
        </h3>
        <p class="text-purple-300 text-center text-sm mb-6">
          Listen to both versions and decide which one fits your needs
        </p>
        <div class="grid sm:grid-cols-2 gap-4">
          <div
            class="bg-gradient-to-r from-pink-500/10 to-purple-500/10 border border-pink-500/30 rounded-2xl p-5"
          >
            <p class="text-sm font-semibold text-white mb-1">
              Premium Version <span class="text-pink-400">(no chorus)</span>
            </p>
            <p class="text-xs text-pink-300 mb-3">
              Preview clip · Full track: {song.duration}
            </p>
            <audio
              controls
              class="w-full"
              style="border-radius: 9999px; height: 36px;"
            >
              <source src={premiumPreviewUrl} type="audio/mpeg" />
            </audio>
          </div>
          <div class="bg-white/5 border border-white/10 rounded-2xl p-5">
            <p class="text-sm font-semibold text-purple-200 mb-1">
              Free Version <span class="text-purple-400">(with chorus)</span>
            </p>
            <p class="text-xs text-purple-400 mb-3">
              Preview clip · Full track: {song.duration}
            </p>
            <audio
              controls
              class="w-full"
              style="border-radius: 9999px; height: 36px;"
            >
              <source src={previewUrl} type="audio/mpeg" />
            </audio>
          </div>
        </div>
        <p class="text-center text-xs text-purple-400 mt-3">
          💡 Notice: The premium version has crystal-clear instrumentation with
          no vocal overlay
        </p>
      </div>
    </div>

    <!-- Karaoke Versions Layout — Premium FIRST (left), Free SECOND (right) -->
    <div
      class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto mb-12 md:items-stretch animate-fade-in-up"
    >
      <!-- Column 1: PREMIUM Version (shown first) -->
      <div
        class="relative group hover:scale-[1.02] transition-all duration-300 flex flex-col"
      >
        <!-- Gradient Border Background Base -->
        <div
          class="absolute -inset-0.5 bg-gradient-to-r from-pink-500 to-purple-600 rounded-[1.5rem] opacity-75 blur-[2px] group-hover:opacity-100 transition duration-500"
        >
        </div>

        <article
          class="relative flex flex-col h-full bg-[#1b0b3b] backdrop-blur-xl rounded-3xl p-8 border border-white/10 overflow-hidden m-[1px]"
        >
          <!-- Best Value Badge -->
          <div
            class="absolute top-0 right-0 bg-gradient-to-r from-pink-500 to-purple-600 text-white text-xs font-bold px-4 py-1.5 rounded-bl-xl z-20 shadow-lg border-b border-l border-white/20"
          >
            MOST POPULAR
          </div>

          <!-- Glow Inside -->
          <div
            class="absolute -bottom-10 -right-10 w-40 h-40 bg-purple-500/20 rounded-full blur-3xl group-hover:bg-purple-500/30 transition-colors pointer-events-none"
          >
          </div>

          <h3
            class="text-2xl font-bold text-white mb-6 relative z-10 pr-16 lg:pr-20"
          >
            Premium Karaoke <span class="text-pink-400">(No Chorus)</span>
          </h3>

          <!-- Anchor Pricing -->
          <div class="mb-6 relative z-10">
            <div class="flex items-baseline gap-3 text-white">
              <span class="text-2xl text-purple-400 line-through font-medium"
                >₹999</span
              >
              <span class="text-5xl font-extrabold tracking-tight"
                >₹{song.price}</span
              >
              <span class="text-purple-300 font-medium">/ track</span>
            </div>
            <div class="flex items-center gap-2 mt-2">
              <span
                class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-green-500/20 text-green-400 border border-green-500/30"
              >
                50% OFF
              </span>
              <p class="text-sm text-purple-300">
                (Inclusive of applicable taxes)
              </p>
            </div>
            <!-- Urgency -->
            <div
              class="mt-3 flex items-center gap-2 px-3 py-2 rounded-xl bg-amber-500/10 border border-amber-500/20"
            >
              <span class="text-amber-400 text-sm">🔥</span>
              <p class="text-xs text-amber-300 font-medium">
                Launch price — Limited time offer
              </p>
            </div>
          </div>

          <ul class="space-y-4 mb-8 relative z-10 flex-grow">
            {
              [
                "Pure instrumental — zero chorus, zero vocals",
                "Crystal-clear studio mastered audio",
                "High-fidelity MP3 format",
                "Perfect for live events & Sunday Mass",
                "Personal use license included",
              ].map((feature) => (
                <li class="flex items-start gap-3 text-purple-100 font-medium">
                  <span class="flex-shrink-0 w-6 h-6 rounded-full bg-gradient-to-r from-pink-500 to-purple-600 flex items-center justify-center shadow-[0_0_10px_rgba(236,72,153,0.3)]">
                    <svg
                      class="w-4 h-4 text-white"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M5 13l4 4L19 7"
                      />
                    </svg>
                  </span>
                  <span>{feature}</span>
                </li>
              ))
            }
          </ul>

          <!-- Social Proof -->
          <div
            class="mb-5 relative z-10 flex items-center gap-2 px-3 py-2 rounded-xl bg-white/5 border border-white/10"
          >
            <span class="text-base">🎤</span>
            <p class="text-xs text-purple-200">
              Trusted by church choirs across Kerala
            </p>
          </div>

          <!-- Payment Form (default state) -->
          <div id="payment-form" class="relative z-10 mt-auto space-y-3">
            <div>
              <input
                type="email"
                id="customer-email"
                placeholder="Your email address"
                required
                class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl text-white placeholder-purple-300/60 focus:outline-none focus:ring-2 focus:ring-pink-500/50 focus:border-pink-500/50 transition-all text-sm"
              />
            </div>
            <button
              id="buy-premium-btn"
              type="button"
              data-song-slug={song.slug}
              data-song-price={song.price}
              data-song-title={song.title}
              data-razorpay-key={razorpayKeyId}
              class="w-full px-6 py-4 bg-gradient-to-r from-pink-500 to-purple-600 hover:from-pink-400 hover:to-purple-500 text-white font-bold rounded-xl shadow-[0_0_20px_rgba(236,72,153,0.4)] hover:shadow-[0_0_30px_rgba(236,72,153,0.6)] transition-all text-center block hover:scale-105 duration-300 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100"
            >
              <span id="btn-text"
                >🔒 Buy Now — ₹{song.price}
                <span class="text-pink-200 text-sm line-through">₹999</span
                ></span
              >
              <span
                id="btn-loading"
                class="hidden items-center justify-center gap-2"
              >
                <svg
                  class="animate-spin h-5 w-5 text-white"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                >
                  <circle
                    class="opacity-25"
                    cx="12"
                    cy="12"
                    r="10"
                    stroke="currentColor"
                    stroke-width="4"></circle>
                  <path
                    class="opacity-75"
                    fill="currentColor"
                    d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                  ></path>
                </svg>
                Creating order...
              </span>
            </button>
            <p
              class="text-xs text-purple-300/70 text-center flex items-center justify-center gap-1"
            >
              <svg
                class="w-3.5 h-3.5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                ></path></svg
              >
              Secured by Razorpay &bull; UPI, Cards, NetBanking
            </p>
          </div>

          <!-- Payment Success State (hidden by default) -->
          <div id="payment-success" class="relative z-10 mt-auto hidden">
            <div class="text-center space-y-4">
              <div
                class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-green-500/20 border border-green-500/30 mx-auto"
              >
                <svg
                  class="w-8 h-8 text-green-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"></path></svg
                >
              </div>
              <h4 class="text-xl font-bold text-green-400">
                Payment Successful!
              </h4>
              <a
                id="download-link"
                href="#"
                download
                class="w-full px-6 py-4 bg-gradient-to-r from-green-500 to-emerald-600 hover:from-green-400 hover:to-emerald-500 text-white font-bold rounded-xl shadow-[0_0_20px_rgba(34,197,94,0.4)] transition-all text-center block hover:scale-105 duration-300"
              >
                ⬇️ Download Premium Karaoke Track
              </a>
              <div class="space-y-1 text-sm">
                <p class="text-purple-200">
                  📧 Confirmation email sent to <span
                    id="success-email"
                    class="text-pink-300 font-medium"></span>
                </p>
                <p class="text-purple-300/70">
                  ⏰ Download link valid for 24 hours
                </p>
                <p class="text-purple-300/70">
                  Payment ID: <span id="success-payment-id" class="font-mono"
                  ></span>
                </p>
              </div>
            </div>
          </div>

          <!-- Payment Error State (hidden by default) -->
          <div id="payment-error" class="relative z-10 mt-auto hidden">
            <div class="text-center space-y-4">
              <div
                class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-red-500/20 border border-red-500/30 mx-auto"
              >
                <svg
                  class="w-8 h-8 text-red-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M6 18L18 6M6 6l12 12"></path></svg
                >
              </div>
              <h4 class="text-xl font-bold text-red-400">Payment Failed</h4>
              <p id="error-message" class="text-purple-200 text-sm">
                Something went wrong. Please try again.
              </p>
              <button
                id="retry-btn"
                type="button"
                class="w-full px-6 py-4 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold rounded-xl transition-colors text-center block cursor-pointer"
              >
                Try Again
              </button>
            </div>
          </div>
        </article>
      </div>

      <!-- Column 2: FREE Version (shown second, on right) -->
      <article
        class="bg-white/10 backdrop-blur-xl rounded-3xl p-8 border border-white/20 transition-all duration-300 relative overflow-hidden group flex flex-col"
      >
        <!-- Glow -->
        <div
          class="absolute top-0 right-0 w-32 h-32 bg-pink-500/20 rounded-full blur-3xl group-hover:bg-pink-500/40 transition-colors pointer-events-none"
        >
        </div>

        <h3 class="text-2xl font-bold text-white mb-6 relative z-10">
          Standard Version <span class="text-purple-300">(With Chorus)</span>
        </h3>

        <div class="mb-6 relative z-10">
          <div class="flex items-baseline gap-2 text-white">
            <span class="text-5xl font-extrabold tracking-tight">FREE</span>
          </div>
          <p class="text-sm text-purple-300 mt-2">For practice & learning</p>
        </div>

        <ul class="space-y-4 mb-6 relative z-10 flex-grow">
          {
            [
              { text: "MP3 format", type: "ok" },
              { text: "Contains chorus vocals (cannot remove)", type: "warn" },
              { text: "Standard audio quality", type: "warn" },
              { text: "Suitable for practice only", type: "ok" },
            ].map((feature) => (
              <li class="flex items-start gap-3 text-purple-100">
                <span
                  class={`flex-shrink-0 w-6 h-6 rounded-full flex items-center justify-center border ${feature.type === "warn" ? "bg-amber-500/10 border-amber-500/30" : "bg-pink-500/20 border-pink-500/30"}`}
                >
                  {feature.type === "warn" ? (
                    <svg
                      class="w-4 h-4 text-amber-400"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                      />
                    </svg>
                  ) : (
                    <svg
                      class="w-4 h-4 text-pink-400"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M5 13l4 4L19 7"
                      />
                    </svg>
                  )}
                </span>
                <span class={feature.type === "warn" ? "text-purple-300" : ""}>
                  {feature.text}
                </span>
              </li>
            ))
          }
        </ul>

        <!-- Conditional Download Link -->
        {
          downloadUrl ? (
            <a
              href={downloadUrl}
              download
              class="w-full mt-auto px-6 py-4 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold rounded-xl transition-colors relative z-10 text-center block"
            >
              Download Free Karaoke MP3
            </a>
          ) : (
            <button
              disabled
              class="w-full mt-auto px-6 py-4 bg-white/5 border border-white/10 text-white/50 font-semibold rounded-xl cursor-not-allowed relative z-10 text-center block"
            >
              Download Not Available
            </button>
          )
        }
        <p class="text-xs text-purple-300 text-center mt-3 relative z-10">
          Free with chorus · Good for practice
        </p>
      </article>
    </div>

    <!-- Perfect For Section -->
    <div class="max-w-3xl mx-auto mb-16 text-center animate-fade-in-up">
      <h3 class="text-xl font-bold text-white mb-6">
        Who Buys the Premium Version?
      </h3>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div class="bg-white/5 border border-white/10 rounded-2xl p-4">
          <div class="text-2xl mb-2">🎤</div>
          <p class="text-sm text-purple-200">Church choirs for Sunday Mass</p>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-2xl p-4">
          <div class="text-2xl mb-2">🎵</div>
          <p class="text-sm text-purple-200">Solo singers at parish events</p>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-2xl p-4">
          <div class="text-2xl mb-2">🙏</div>
          <p class="text-sm text-purple-200">
            Prayer groups & devotional programs
          </p>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-2xl p-4">
          <div class="text-2xl mb-2">🎶</div>
          <p class="text-sm text-purple-200">
            Music ministries & worship teams
          </p>
        </div>
      </div>
    </div>

    <!-- Song Lyrics Section -->
    {song.hasLyrics && song.lyrics && (
      <section class="max-w-4xl mx-auto mb-16 animate-fade-in-up">
        <div class="bg-indigo-900/40 border border-white/10 rounded-3xl p-6 md:p-10 backdrop-blur-sm">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
            <h2 class="text-3xl font-bold text-white">{song.title} Lyrics</h2>
            <div class="flex gap-2" id="lyrics-tabs">
              <button
                id="tab-manglish"
                type="button"
                class="px-4 py-2 rounded-xl text-sm font-semibold bg-gradient-to-r from-pink-500 to-purple-600 text-white shadow-lg cursor-pointer transition-all"
              >
                Manglish
              </button>
              <button
                id="tab-malayalam"
                type="button"
                class="px-4 py-2 rounded-xl text-sm font-semibold bg-white/10 text-purple-200 border border-white/10 hover:bg-white/20 cursor-pointer transition-all"
              >
                Malayalam
              </button>
            </div>
          </div>

          <div id="lyrics-manglish" class="whitespace-pre-line text-purple-100 leading-relaxed text-lg font-medium">
            {song.lyrics.manglish}
          </div>
