  <!-- Lyrics Tab Switching -->
  <script>
    const tabManglish = document.getElementById('tab-manglish');
    const tabMalayalam = document.getElementById('tab-malayalam');
    const lyricsManglish = document.getElementById('lyrics-manglish');
    const lyricsMalayalam = document.getElementById('lyrics-malayalam');

    if (tabManglish && tabMalayalam && lyricsManglish && lyricsMalayalam) {
      const activeClass = 'bg-gradient-to-r from-pink-500 to-purple-600 text-white shadow-lg';
      const inactiveClass = 'bg-white/10 text-purple-200 border border-white/10';

      tabManglish.addEventListener('click', () => {
        lyricsManglish.classList.remove('hidden');
        lyricsMalayalam.classList.add('hidden');
        tabManglish.className = `px-4 py-2 rounded-xl text-sm font-semibold ${activeClass} cursor-pointer transition-all`;
        tabMalayalam.className = `px-4 py-2 rounded-xl text-sm font-semibold ${inactiveClass} hover:bg-white/20 cursor-pointer transition-all`;
      });

      tabMalayalam.addEventListener('click', () => {
        lyricsMalayalam.classList.remove('hidden');
        lyricsManglish.classList.add('hidden');
        tabMalayalam.className = `px-4 py-2 rounded-xl text-sm font-semibold ${activeClass} cursor-pointer transition-all`;
        tabManglish.className = `px-4 py-2 rounded-xl text-sm font-semibold ${inactiveClass} hover:bg-white/20 cursor-pointer transition-all`;
      });
    }
  </script>

  <!-- Razorpay Checkout Script -->
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const buyBtn = document.getElementById(
        "buy-premium-btn",
      ) as HTMLButtonElement;
      const emailInput = document.getElementById(
        "customer-email",
      ) as HTMLInputElement;
      const btnText = document.getElementById("btn-text")!;
      const btnLoading = document.getElementById("btn-loading")!;
      const paymentForm = document.getElementById("payment-form")!;
      const paymentSuccess = document.getElementById("payment-success")!;
      const paymentError = document.getElementById("payment-error")!;
      const downloadLink = document.getElementById(
        "download-link",
      ) as HTMLAnchorElement;
      const successEmail = document.getElementById("success-email")!;
      const successPaymentId = document.getElementById("success-payment-id")!;
      const errorMessage = document.getElementById("error-message")!;
      const retryBtn = document.getElementById("retry-btn")!;

      if (!buyBtn) return;

      const songSlug = buyBtn.dataset.songSlug!;
      const songPrice = buyBtn.dataset.songPrice!;
      const songTitle = buyBtn.dataset.songTitle!;
      const razorpayKey = buyBtn.dataset.razorpayKey!;

      function showState(state: "form" | "success" | "error") {
        paymentForm.classList.toggle("hidden", state !== "form");
        paymentSuccess.classList.toggle("hidden", state !== "success");
        paymentError.classList.toggle("hidden", state !== "error");
      }

      function setLoading(loading: boolean) {
        buyBtn.disabled = loading;
        btnText.classList.toggle("hidden", loading);
        btnLoading.classList.toggle("hidden", !loading);
        if (loading) btnLoading.classList.add("flex");
        else btnLoading.classList.remove("flex");
      }

      async function startPayment() {
        const email = emailInput.value.trim();

        // Validate email
        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          emailInput.classList.add(
            "ring-2",
            "ring-red-500/50",
            "border-red-500/50",
          );
          emailInput.focus();
          setTimeout(() => {
            emailInput.classList.remove(
              "ring-2",
              "ring-red-500/50",
              "border-red-500/50",
            );
          }, 2000);
          return;
        }

        setLoading(true);

        try {
          // Step 1: Create order on our server
          const orderRes = await fetch("/api/create-order", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ songSlug, email }),
          });

          if (!orderRes.ok) {
            const err = await orderRes.json();
            throw new Error(err.error || "Failed to create order");
          }

          const orderData = await orderRes.json();

          // Step 2: Open Razorpay Checkout
          const options = {
            key: razorpayKey,
            amount: orderData.amount,
            currency: orderData.currency,
            name: "HolyfireMedia",
            description: `Premium Karaoke: ${songTitle}`,
            order_id: orderData.orderId,
            prefill: {
              email: email,
            },
            theme: {
              color: "#ec4899",
              backdrop_color: "rgba(15, 5, 36, 0.85)",
            },
            handler: async function (response: any) {
              // Step 3: Verify payment on our server
              setLoading(true);
              btnText.textContent = "Verifying payment...";
              setLoading(true);

              try {
                const verifyRes = await fetch("/api/verify-payment", {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({
                    razorpay_order_id: response.razorpay_order_id,
                    razorpay_payment_id: response.razorpay_payment_id,
                    razorpay_signature: response.razorpay_signature,
                    songSlug,
                    email,
                  }),
                });

                const verifyData = await verifyRes.json();

                if (verifyRes.ok && verifyData.success) {
                  // Success!
                  if (verifyData.downloadUrl) {
                    downloadLink.href = verifyData.downloadUrl;
                  } else {
                    downloadLink.textContent =
                      "📧 File will be sent to your email";
                    downloadLink.removeAttribute("href");
                    downloadLink.classList.remove("hover:scale-105");
                  }
                  successEmail.textContent = email;
                  successPaymentId.textContent = response.razorpay_payment_id;
                  showState("success");
                } else {
                  throw new Error(verifyData.error || "Verification failed");
                }
              } catch (verifyError: any) {
                errorMessage.textContent =
                  verifyError.message ||
                  "Payment verification failed. Don't worry, if money was deducted it will be refunded.";
                showState("error");
              }
            },
            modal: {
              ondismiss: function () {
                setLoading(false);
              },
            },
          };

          const rzp = new (window as any).Razorpay(options);
          rzp.on("payment.failed", function (response: any) {
            errorMessage.textContent =
              response.error?.description ||
              "Payment failed. Please try again.";
            showState("error");
          });
          rzp.open();
          setLoading(false);
        } catch (err: any) {
          errorMessage.textContent =
            err.message || "Something went wrong. Please try again.";
          showState("error");
        }
      }

      buyBtn.addEventListener("click", startPayment);

      // Allow Enter key in email input to trigger payment
      emailInput.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          startPayment();
        }
      });

      // Retry button
      retryBtn.addEventListener("click", () => {
        showState("form");
        setLoading(false);
      });
    });
  </script>

