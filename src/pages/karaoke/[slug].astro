---
import MainLayout from "../../layouts/MainLayout.astro";
import { songs } from "../../data/songs";
import { getLanguage } from "../../data/languages";
import aradhyaneFile from "../../assets/Aradhyane_Parishudane_Ennullam_Thirayunnori_sneham.mp3";
import previewEnullam from "../../assets/enullam_sample.MP3";
import previewNoChorus from "../../assets/enullam_sample_no_chorus.MP3";

export async function getStaticPaths() {
  return songs
    .filter((song) => song.hasKaraoke)
    .map((song) => {
      return {
        params: { slug: song.slug },
        props: { song },
      };
    });
}

const { song } = Astro.props;
const { slug } = Astro.params;
const lang = getLanguage(song.language);

let downloadUrl = song.freeFile;
let previewUrl = `/audio/preview-${song.slug}.mp3`;
let premiumPreviewUrl = `/audio/preview-premium-${song.slug}.mp3`;
if (slug === "aradhyane-parishudhane") {
  downloadUrl = aradhyaneFile;
  previewUrl = previewEnullam;
  premiumPreviewUrl = previewNoChorus;
}

const hasFreeVersion = song.hasFreeVersion !== false && (!!downloadUrl || song.slug === "aradhyane-parishudhane");
const hasPremiumVersion = song.hasPremiumVersion !== false && song.price > 0;
const isDualVersion = hasFreeVersion && hasPremiumVersion;
const premiumType = song.premiumType || "no-chorus";
const originalPrice = song.originalPrice || (song.price ? song.price * 2 : 0);
const discountPercent = originalPrice > song.price ? Math.round(((originalPrice - song.price) / originalPrice) * 100) : 0;

const pageUrl = `https://holyfiremedia.in/karaoke/${song.slug}/`;
const artistUrl = song.artistSlug
  ? `https://holyfiremedia.in/artists/${song.artistSlug}/`
  : "https://holyfiremedia.in/artists/";
const artistHref = song.artistSlug ? `/artists/${song.artistSlug}` : "/artists";
const songAliases = song.alternateTitles || [];
const aliasText = songAliases.length
  ? ` Also searched as ${songAliases.join(", ")}.`
  : "";
const previewFileUrl = previewUrl
  ? new URL(previewUrl, Astro.url).href
  : undefined;
const [durationMinutes = 0, durationSeconds = 0] = song.duration
  .split(":")
  .map(Number);
const isoDuration = `PT${durationMinutes}M${durationSeconds}S`;
const razorpayKeyId = import.meta.env.PUBLIC_RAZORPAY_KEY_ID || "";

let pageDescription = "";
if (isDualVersion) {
  pageDescription = `Download ${song.title} ${lang.name} Christian karaoke track by ${song.artist}. Free MP3 with chorus and premium studio instrumental available for ${lang.name} Christian worship.${aliasText}`;
} else if (hasPremiumVersion) {
  pageDescription = `Download premium studio karaoke track (${premiumType === "with-chorus" ? "with backing chorus" : "without chorus"}) for ${song.title} by ${song.artist}. High-fidelity ${lang.name} Christian devotional instrumental available for worship and singing.${aliasText}`;
} else {
  pageDescription = `Download free MP3 karaoke track for ${song.title} by ${song.artist}. High-quality ${lang.name} devotional track for personal singing and worship practice.${aliasText}`;
}

const productSchemaOffers = [];
if (hasFreeVersion) {
  productSchemaOffers.push({
    "@type": "Offer",
    name: `Free ${lang.name} MP3 karaoke with chorus`,
    price: "0",
    priceCurrency: "INR",
    availability: "https://schema.org/InStock",
    url: pageUrl,
    shippingDetails: {
      "@type": "OfferShippingDetails",
      shippingRate: {
        "@type": "MonetaryAmount",
        value: "0",
        currency: "INR",
      },
      shippingDestination: {
        "@type": "DefinedRegion",
        addressCountry: "IN",
      },
    },
    hasMerchantReturnPolicy: {
      "@type": "MerchantReturnPolicy",
      applicableCountry: "IN",
      returnPolicyCategory: "https://schema.org/MerchantReturnNotPermitted",
    },
  });
}
if (hasPremiumVersion) {
  productSchemaOffers.push({
    "@type": "Offer",
    name: premiumType === "with-chorus" ? `Premium ${lang.name} studio karaoke with chorus` : `Premium ${lang.name} studio instrumental karaoke`,
    price: String(song.price),
    priceCurrency: "INR",
    availability: "https://schema.org/InStock",
    url: pageUrl,
    shippingDetails: {
      "@type": "OfferShippingDetails",
      shippingRate: {
        "@type": "MonetaryAmount",
        value: "0",
        currency: "INR",
      },
      shippingDestination: {
        "@type": "DefinedRegion",
        addressCountry: "IN",
      },
    },
    hasMerchantReturnPolicy: {
      "@type": "MerchantReturnPolicy",
      applicableCountry: "IN",
      returnPolicyCategory: "https://schema.org/MerchantReturnNotPermitted",
    },
  });
}

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: `${song.title} (${lang.name} Christian Karaoke Track)`,
  description: pageDescription,
  image: song.thumbnail ? `https://holyfiremedia.in${song.thumbnail}` : "https://holyfiremedia.in/holy_fire_logo.webp",
  brand: {
    "@type": "Brand",
    name: "HolyfireMedia",
  },
  category: "Digital music download",
  url: pageUrl,
  offers: productSchemaOffers,
};

const musicSchema = {
  "@context": "https://schema.org",
  "@type": "MusicRecording",
  name: song.title,
  alternateName: songAliases,
  byArtist: {
    "@type": "Person",
    name: song.artist,
    url: artistUrl,
  },
  inLanguage: [lang.code, "en"],
  genre: `${lang.name} Christian Devotional`,
  description: song.description,
  duration: isoDuration,
  url: pageUrl,
  ...(previewFileUrl ? { audio: previewFileUrl } : {}),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://holyfiremedia.in/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Karaoke",
      item: "https://holyfiremedia.in/karaoke/",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: `${song.title} Karaoke Download`,
      item: pageUrl,
    },
  ],
};

const faqList = isDualVersion
  ? [
      {
        q: `Can I download ${song.title} karaoke for free?`,
        a: `Yes. HolyfireMedia provides a free MP3 karaoke version of ${song.title} with chorus for personal devotional practice.`,
      },
      {
        q: "Is there a premium studio version available?",
        a: `Yes. A premium studio instrumental version is available for ${song.price} INR per track.`,
      },
      {
        q: "Who is the artist?",
        a: `${song.title} is a ${lang.name} Christian devotional song by <a href="${artistHref}" class="text-pink-300 hover:text-pink-200 underline">${song.artist}</a>.`,
      },
    ]
  : (hasPremiumVersion
      ? [
          {
            q: `What is included in the premium karaoke for ${song.title}?`,
            a: `The premium version is a high-fidelity studio-mastered MP3 instrumental track ${premiumType === "with-chorus" ? "with backing chorus" : "with absolutely no backup vocals or chorus"}.`,
          },
          {
            q: "How will I receive the files after payment?",
            a: "Immediately upon successful payment, a signed download link will be shown on the page, and a copy will be sent to your email address (valid for 24 hours).",
          },
          {
            q: "Who is the artist?",
            a: `${song.title} is a ${lang.name} Christian devotional song by <a href="${artistHref}" class="text-pink-300 hover:text-pink-200 underline">${song.artist}</a>.`,
          },
        ]
      : [
          {
            q: `Can I download ${song.title} karaoke for free?`,
            a: `Yes! ${song.title} is completely free to download directly on HolyfireMedia for personal devotion and practice.`,
          },
          {
            q: "Does this track have chorus?",
            a: `Yes, this free karaoke track includes chorus backing vocals to guide your singing.`,
          },
          {
            q: "Who is the artist?",
            a: `${song.title} is a ${lang.name} Christian devotional song by <a href="${artistHref}" class="text-pink-300 hover:text-pink-200 underline">${song.artist}</a>.`,
          },
        ]);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqList.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a.replace(/<[^>]*>/g, ""),
    },
  })),
};
---

<MainLayout
  title={`${song.title} Karaoke Download MP3 | ${lang.name} Christian Song | ${song.artist} | HolyfireMedia`}
  description={pageDescription}
  keywords={`${song.title} karaoke download, ${song.title} ${lang.name} karaoke, ${song.title} karaoke ${lang.name}, ${song.artist} karaoke, ${lang.name} Christian karaoke download, Catholic devotional karaoke ${lang.name}, ${songAliases.join(", ")}`}
  image={song.thumbnail}
  ogType="music.song"
  schemaData={[productSchema, musicSchema, breadcrumbSchema, faqSchema]}
>
  <div class="container mx-auto px-4 py-16">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <a
        href="/karaoke"
        class="inline-flex items-center text-pink-400 hover:text-pink-300 transition-colors mb-8 group"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5 mr-2 transform group-hover:-translate-x-1 transition-transform"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to Karaoke List
      </a>

      <h1
        class="text-4xl md:text-6xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-pink-300 to-purple-300 drop-shadow-lg mb-6"
      >
        {song.title} Karaoke Download
      </h1>
      <p class="text-2xl text-white mb-6 font-semibold">
        Artist: <a
          href={artistHref}
          class="hover:text-pink-300 transition-colors underline decoration-pink-400/40 underline-offset-4"
          >{song.artist}</a
        >
      </p>
    </div>

    <!-- Karaoke Versions Layout -->
    <div
      class={isDualVersion
        ? "grid md:grid-cols-2 gap-8 max-w-5xl mx-auto mb-12 md:items-stretch animate-fade-in-up"
        : "max-w-md mx-auto mb-12 animate-fade-in-up"}
    >
      <!-- Column 1: PREMIUM Version (only if hasPremiumVersion) -->
      {hasPremiumVersion && (
        <div
          class="relative group hover:scale-[1.02] transition-all duration-300 flex flex-col"
        >
          <!-- Gradient Border Background Base -->
          <div
            class="absolute -inset-0.5 bg-gradient-to-r from-pink-500 to-purple-600 rounded-[1.5rem] opacity-75 blur-[2px] group-hover:opacity-100 transition duration-500"
          >
          </div>

          <article
            class="relative flex flex-col h-full bg-[#1b0b3b] backdrop-blur-xl rounded-3xl p-8 border border-white/10 overflow-hidden m-[1px]"
          >
            <!-- Best Value Badge -->
            <div
              class="absolute top-0 right-0 bg-gradient-to-r from-pink-500 to-purple-600 text-white text-xs font-bold px-4 py-1.5 rounded-bl-xl z-20 shadow-lg border-b border-l border-white/20"
            >
              MOST POPULAR
            </div>

            <!-- Glow Inside -->
            <div
              class="absolute -bottom-10 -right-10 w-40 h-40 bg-purple-500/20 rounded-full blur-3xl group-hover:bg-purple-500/30 transition-colors pointer-events-none"
            >
            </div>

            <h3
              class="text-2xl font-bold text-white mb-6 relative z-10 pr-16 lg:pr-20"
            >
              Premium Karaoke <span class="text-pink-400">({premiumType === "with-chorus" ? "With Chorus" : "No Chorus"})</span>
            </h3>

            <!-- Anchor Pricing -->
            <div class="mb-6 relative z-10">
              <div class="flex items-baseline gap-3 text-white">
                {originalPrice > song.price && (
                  <span class="text-2xl text-purple-400 line-through font-medium">
                    ₹{originalPrice}
                  </span>
                )}
                <span class="text-5xl font-extrabold tracking-tight">
                  ₹{song.price}
                </span>
                <span class="text-purple-300 font-medium">/ track</span>
              </div>
              {discountPercent > 0 && (
                <div class="flex items-center gap-2 mt-2">
                  <span
                    class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-green-500/20 text-green-400 border border-green-500/30"
                  >
                    {discountPercent}% OFF
                  </span>
                  <p class="text-sm text-purple-300">
                    (Inclusive of applicable taxes)
                  </p>
                </div>
              )}
              <!-- Urgency -->
              <div
                class="mt-3 flex items-center gap-2 px-3 py-2 rounded-xl bg-amber-500/10 border border-amber-500/20"
              >
                <span class="text-amber-400 text-sm">🔥</span>
                <p class="text-xs text-amber-300 font-medium">
                  Launch price — Limited time offer
                </p>
              </div>
            </div>

            <ul class="space-y-4 mb-8 relative z-10 flex-grow">
              {
                [
                  premiumType === "with-chorus"
                    ? "Instrumental track with high-quality backing chorus"
                    : "Pure instrumental — zero chorus, zero vocals",
                  "Crystal-clear studio mastered audio",
                  "High-fidelity MP3 format",
                  "Perfect for live events & Sunday Mass",
                  "Personal use license included",
                ].map((feature) => (
                  <li class="flex items-start gap-3 text-purple-100 font-medium">
                    <span class="flex-shrink-0 w-6 h-6 rounded-full bg-gradient-to-r from-pink-500 to-purple-600 flex items-center justify-center shadow-[0_0_10px_rgba(236,72,153,0.3)]">
                      <svg
                        class="w-4 h-4 text-white"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M5 13l4 4L19 7"
                        />
                      </svg>
                    </span>
                    <span>{feature}</span>
                  </li>
                ))
              }
            </ul>

            <!-- Social Proof -->
            <div
              class="mb-5 relative z-10 flex items-center gap-2 px-3 py-2 rounded-xl bg-white/5 border border-white/10"
            >
              <span class="text-base">🎤</span>
              <p class="text-xs text-purple-200">
                Trusted by church choirs across Kerala
              </p>
            </div>

            <!-- Payment Form (default state) -->
            <div id="payment-form" class="relative z-10 mt-auto space-y-3">
              <div>
                <input
                  type="email"
                  id="customer-email"
                  placeholder="Your email address"
                  required
                  class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl text-white placeholder-purple-300/60 focus:outline-none focus:ring-2 focus:ring-pink-500/50 focus:border-pink-500/50 transition-all text-sm"
                />
              </div>
              <button
                id="buy-premium-btn"
                type="button"
                data-song-slug={song.slug}
                data-song-price={song.price}
                data-song-title={song.title}
                data-razorpay-key={razorpayKeyId}
                class="w-full px-6 py-4 bg-gradient-to-r from-pink-500 to-purple-600 hover:from-pink-400 hover:to-purple-500 text-white font-bold rounded-xl shadow-[0_0_20px_rgba(236,72,153,0.4)] hover:shadow-[0_0_30px_rgba(236,72,153,0.6)] transition-all text-center block hover:scale-105 duration-300 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100"
              >
                <span id="btn-text"
                  >🔒 Buy Now — ₹{song.price}
                  {originalPrice > song.price && (
                    <span class="text-pink-200 text-sm line-through">₹{originalPrice}</span>
                  )}
                </span>
                <span
                  id="btn-loading"
                  class="hidden items-center justify-center gap-2"
                >
                  <svg
                    class="animate-spin h-5 w-5 text-white"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                  >
                    <circle
                      class="opacity-25"
                      cx="12"
                      cy="12"
                      r="10"
                      stroke="currentColor"
                      stroke-width="4"></circle>
                    <path
                      class="opacity-75"
                      fill="currentColor"
                      d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                    ></path>
                  </svg>
                  Creating order...
                </span>
              </button>
              <p
                class="text-xs text-purple-300/70 text-center flex items-center justify-center gap-1"
              >
                <svg
                  class="w-3.5 h-3.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                  ></path></svg
                >
                Secured by Razorpay &bull; UPI, Cards, NetBanking
              </p>
            </div>

            <!-- Payment Success State (hidden by default) -->
            <div id="payment-success" class="relative z-10 mt-auto hidden">
              <div class="text-center space-y-4">
                <div
                  class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-green-500/20 border border-green-500/30 mx-auto"
                >
                  <svg
                    class="w-8 h-8 text-green-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M5 13l4 4L19 7"></path></svg
                  >
                </div>
                <h4 class="text-xl font-bold text-green-400">
                  Payment Successful!
                </h4>
                <a
                  id="download-link"
                  href="#"
                  download
                  class="w-full px-6 py-4 bg-gradient-to-r from-green-500 to-emerald-600 hover:from-green-400 hover:to-emerald-500 text-white font-bold rounded-xl shadow-[0_0_20px_rgba(34,197,94,0.4)] transition-all text-center block hover:scale-105 duration-300"
                >
                  ⬇️ Download Premium Karaoke Track
                </a>
                <div class="space-y-1 text-sm">
                  <p class="text-purple-200">
                    📧 Confirmation email sent to <span
                      id="success-email"
                      class="text-pink-300 font-medium"></span>
                  </p>
                  <p class="text-purple-300/70">
                    ⏰ Download link valid for 24 hours
                  </p>
                  <p class="text-purple-300/70">
                    Payment ID: <span id="success-payment-id" class="font-mono"
                    ></span>
                  </p>
                </div>
              </div>
            </div>

            <!-- Payment Error State (hidden by default) -->
            <div id="payment-error" class="relative z-10 mt-auto hidden">
              <div class="text-center space-y-4">
                <div
                  class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-red-500/20 border border-red-500/30 mx-auto"
                >
                  <svg
                    class="w-8 h-8 text-red-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M6 18L18 6M6 6l12 12"></path></svg
                  >
                </div>
                <h4 class="text-xl font-bold text-red-400">Payment Failed</h4>
                <p id="error-message" class="text-purple-200 text-sm">
                  Something went wrong. Please try again.
                </p>
                <button
                  id="retry-btn"
                  type="button"
                  class="w-full px-6 py-4 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold rounded-xl transition-colors text-center block cursor-pointer"
                >
                  Try Again
                </button>
              </div>
            </div>
          </article>
        </div>
      )}

      <!-- Column 2: FREE Version -->
      {hasFreeVersion && (
        <div class={`relative group hover:scale-[1.02] transition-all duration-300 flex flex-col ${!hasPremiumVersion ? "m-[1px]" : ""}`}>
          {!hasPremiumVersion && (
            <div class="absolute -inset-0.5 bg-gradient-to-r from-emerald-500 to-teal-600 rounded-[1.5rem] opacity-75 blur-[2px] group-hover:opacity-100 transition duration-500"></div>
          )}
          <article
            class={`relative flex flex-col h-full bg-[#1b0b3b] backdrop-blur-xl rounded-3xl p-8 border border-white/20 transition-all duration-300 overflow-hidden ${!hasPremiumVersion ? "border-white/10" : ""}`}
          >
            <!-- Badge for Free -->
            <div
              class="absolute top-0 right-0 bg-gradient-to-r from-emerald-500 to-teal-600 text-white text-xs font-bold px-4 py-1.5 rounded-bl-xl z-20 shadow-lg border-b border-l border-white/20"
            >
              FREE DOWNLOAD
            </div>

            <!-- Glow -->
            <div
              class="absolute top-0 right-0 w-32 h-32 bg-emerald-500/20 rounded-full blur-3xl group-hover:bg-emerald-500/40 transition-colors pointer-events-none"
            >
            </div>

            <h3 class="text-2xl font-bold text-white mb-6 relative z-10 pr-16">
              Standard Version <span class="text-purple-300">(With Chorus)</span>
            </h3>

            <div class="mb-6 relative z-10">
              <div class="flex items-baseline gap-2 text-white">
                <span class="text-5xl font-extrabold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-300">FREE</span>
              </div>
              <p class="text-sm text-purple-300 mt-2">For personal devotion & singing practice</p>
            </div>

            <ul class="space-y-4 mb-8 relative z-10 flex-grow">
              {
                [
                  { text: "High-quality MP3 format", type: "ok" },
                  { text: "Contains chorus vocals to guide melody", type: "info" },
                  { text: "Standard audio quality", type: "ok" },
                  { text: "Free for personal & prayer practice", type: "ok" },
                ].map((feature) => (
                  <li class="flex items-start gap-3 text-purple-100 font-medium">
                    <span
                      class="flex-shrink-0 w-6 h-6 rounded-full bg-gradient-to-r from-emerald-500 to-teal-600 flex items-center justify-center shadow-[0_0_10px_rgba(16,185,129,0.3)]"
                    >
                      <svg
                        class="w-4 h-4 text-white"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M5 13l4 4L19 7"
                        />
                      </svg>
                    </span>
                    <span>
                      {feature.text}
                    </span>
                  </li>
                ))
              }
            </ul>

            <!-- Conditional Download Link -->
            {
              downloadUrl ? (
                <a
                  href={downloadUrl}
                  download
                  class="w-full mt-auto px-6 py-4 bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white font-bold rounded-xl shadow-[0_0_20px_rgba(16,185,129,0.4)] hover:shadow-[0_0_30px_rgba(16,185,129,0.6)] transition-all text-center block hover:scale-105 duration-300 relative z-10"
                >
                  ⬇️ Download Free Karaoke MP3
                </a>
              ) : (
                <button
                  disabled
